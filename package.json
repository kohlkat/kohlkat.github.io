{
  "name": "sage-suite-public-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "generate:simulation": "node scripts/generate-public-simulation.mjs",
    "generate:replay": "node scripts/render-public-replay.mjs",
    "check:simulation": "node scripts/generate-public-simulation.mjs --check",
    "check:replay": "node scripts/render-public-replay.mjs --check",
    "check:seo": "node scripts/verify-static-export.mjs",
    "verify": "npm run check:simulation && npm run check:replay && npm run build && npm run check:seo"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
